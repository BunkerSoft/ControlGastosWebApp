@model IEnumerable<ControlGastosWebApp.Models.FondoMonetario>

<h2>Fondos Monetarios</h2>

<p><a asp-action='Create' class='btn btn-success'>Crear Nuevo</a></p>

<table class='table table-striped'>
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td>@item.Tipo</td>
            <td>
                <a asp-action='Edit' asp-route-id='@item.Id' class='btn btn-primary btn-sm'>Editar</a>
                <a asp-action='Delete' asp-route-id='@item.Id' class='btn btn-danger btn-sm' onclick='return confirm(\"¿Eliminar este fondo?\");'>Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
