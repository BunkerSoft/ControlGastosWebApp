@model IEnumerable<ControlGastosWebApp.Models.Presupuesto>

<h2>Presupuestos</h2>

<p><a asp-action='Create' class='btn btn-success'>Crear Nuevo</a></p>

<table class='table table-striped'>
    <thead>
        <tr>
            <th>Id</th>
            <th>Mes/Año</th>
            <th>Tipo de Gasto</th>
            <th>Monto</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Mes.ToString('MMMM yyyy')</td>
            <td>@item.TipoGasto?.Nombre</td>
            <td>@item.Monto.ToString('C')</td>
            <td>
                <a asp-action='Edit' asp-route-id='@item.Id' class='btn btn-primary btn-sm'>Editar</a>
                <a asp-action='Delete' asp-route-id='@item.Id' class='btn btn-danger btn-sm' onclick='return confirm(\"�Eliminar este presupuesto?\");'>Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
