@model IEnumerable<Movimiento>

@{
    ViewData["Title"] = "Registro de Gastos";
}

<div class="container-fluid">
    <h2>Registro de Gastos</h2>
    
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nuevo Gasto
        </a>
    </div>

    <!-- Tabla simple en lugar de DevExtreme -->
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Fondo</th>
                <th>Nombre Comercio</th>
                <th>Monto Total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Fecha.ToShortDateString()</td>
                <td>@m.FondoMonetario?.Nombre</td>
                <td>@m.NombreComercio</td>
                <td>@m.MontoTotal.ToString("C2")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>