@model Movimiento

<div class="container">
    <h2>Nuevo Gasto</h2>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="Fecha" class="control-label"></label>
                    <input asp-for="Fecha" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label asp-for="FondoMonetarioId" class="control-label">Fondo Monetario</label>
                    <select asp-for="FondoMonetarioId" class="form-control" asp-items="ViewBag.FondosMonetarios"></select>
                </div>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="TipoGastoId" class="control-label">Tipo de Gasto</label>
            <select asp-for="TipoGastoId" class="form-control" asp-items="ViewBag.TiposGasto"></select>
        </div>
        <div class="form-group">
            <label asp-for="Monto" class="control-label"></label>
            <input asp-for="Monto" class="form-control" />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </div>
    </form>
</div>