@model IEnumerable<ControlGastosWebApp.Models.TipoGasto>

<h2>Tipos de Gasto</h2>

<p><a asp-action='Create'>Crear Nuevo</a></p>

<table class='table'>
    <thead>
        <tr><th>Id</th><th>Nombre</th><th>Acciones</th></tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>
                    <a asp-action='Edit' asp-route-id='@item.Id'>Editar</a> |
                    <a asp-action='Delete' asp-route-id='@item.Id' onclick='return confirm(\"¿Eliminar este tipo de gasto?\");'>Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
